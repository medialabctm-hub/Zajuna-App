{
  "name": "zajuna-app",
  "version": "0.1.6",
  "author": "Zajuna App",
  "description": "Aplicación de escritorio multiplataforma para Zajuna",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "npm run build && electron .",
    "desktop:start": "electron .",
    "frontend:install": "npm ci --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:sync": "node scripts/sync-frontend.cjs",
    "core:build": "npm run frontend:sync && node scripts/build-core.cjs",
    "core:build:targets": "node scripts/build-core-targets.cjs",
    "build:platforms": "npm run frontend:build && npm run frontend:sync && npm run core:build:targets",
    "browser:install": "node scripts/install-playwright.cjs",
    "build": "npm run frontend:build && npm run core:build",
    "prepackage": "npm run frontend:install && npm run build:platforms && npm run browser:install",
    "package": "node scripts/package.cjs",
    "package:windows": "npm run build:platforms && npm run browser:install && node scripts/package.cjs --win --x64",
    "package:linux": "npm run build:platforms && npm run browser:install && node scripts/package.cjs --linux --x64",
    "release:metadata": "node scripts/release-metadata.cjs",
    "release:downloads": "node scripts/prepare-downloads.cjs",
    "test:downloads": "node scripts/prepare-downloads.test.cjs",
    "test:smoke:packaged": "node scripts/smoke-packaged.cjs",
    "test:smoke:external-browser": "node scripts/smoke-external-browser.cjs",
    "smoke:native": "node scripts/smoke-native.cjs",
    "test:smoke:native": "node scripts/smoke-native.test.cjs",
    "test:desktop": "node desktop/stop-process-tree.test.cjs",
    "test:core": "go -C core test ./...",
    "test:e2e:core": "go -C core test ./cmd/zajuna-core -run TestLocalE2ESetupCaptureReportBackup -v",
    "test:visual:core": "powershell -NoProfile -Command \"$env:ZAJUNA_PLAYWRIGHT_DIR=(Join-Path (Get-Location) 'core/bin/playwright'); $env:ZAJUNA_RUN_BROWSER_SMOKE='1'; go -C core test ./cmd/zajuna-core -run TestDashboardBrowserSmoke -v\"",
    "test:browser:core": "powershell -NoProfile -Command \"$env:ZAJUNA_PLAYWRIGHT_DIR=(Join-Path (Get-Location) 'core/bin/playwright'); $env:ZAJUNA_RUN_BROWSER_SMOKE='1'; go -C core test ./... -run 'TestDashboardBrowserSmoke|TestEvidenciasBrowserSmoke|TestCriticalPagesBrowserSmoke|TestLocalE2ESetupCaptureReportBackup|TestCaptureBrowserWorkerPersistsPNGSmoke|TestCaptureBrowserWorkerTransfersEphemeralSessionToChromium' -v\"",
    "test:e2e:zajuna": "powershell -NoProfile -Command \"$env:ZAJUNA_PLAYWRIGHT_DIR=(Join-Path (Get-Location) 'core/bin/playwright'); go -C core test ./cmd/zajuna-core -run TestAuthenticatedZajunaE2E -v\""
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.zajuna.app",
    "productName": "Zajuna App",
    "artifactName": "Zajuna.App-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "core/bin",
        "to": "core"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "medialabctm-hub",
        "repo": "Zajuna-App"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Zajuna.App.Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Education"
    }
  },
  "dependencies": {
    "electron-updater": "~6.8.9"
  }
}
